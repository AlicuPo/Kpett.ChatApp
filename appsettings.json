{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "MediaSettings": {
    "MaxImageSizeBytes": 5242880,
    "MaxVideoSizeBytes": 0,
    "MaxReelSizeBytes": 262144000,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".gif" ],
    "AllowedVideoExtensions": [ ".mp4", ".mov", ".webm" ]
  },

  "AutoPost": {
    "Enabled": false,
    "BotUserId": null,
    "BotUsername": "kpett_official",
    "BotEmail": "bot@kpett.local",
    "Cron": "0 * * * *",
    "MaxPostsPerRun": 2,
    "RssFeeds": [
      "https://vnexpress.net/rss/tin-moi-nhat.rss",
      "https://vnexpress.net/rss/the-gioi.rss"
    ]
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Kpett.ChatApp.Api"
    }
  }
}
